{
  "name": "multi-vpn-decryptor-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && pnpm run check && vite build",
    "build:wasm": "wasm-pack build ../decryptor-core --target web --release --out-dir ../web/src/wasm",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wasm-pack": "^0.15.0"
  }
}
